{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run lint)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run build)",
      "Bash(pnpm run dev)",
      "Bash(pnpm run type-check)",
      "Bash(pnpm add *)",
      "Bash(npx prettier --write *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(uvicorn *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "mcp__context7__*",
      "mcp__playwright__*",
      "mcp__github__*",
      "mcp__sequential-thinking__*"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git branch --show-current 2>/dev/null)\" != \"main\" ] || { echo '{\"block\": true, \"message\": \"Cannot edit directly on main branch. Create a feature branch first.\"}' >&2; exit 2; }"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo $CLAUDE_TOOL_INPUT | jq -r '.command' | grep -q '\\--no-verify' && { echo '{\"block\": true, \"message\": \"Never skip git hooks with --no-verify\"}' >&2; exit 2; } || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; RUFF=\"${CLAUDE_PROJECT_DIR:-.}/.venv/bin/ruff\"; command -v \"$RUFF\" >/dev/null 2>&1 || RUFF=ruff; case \"$FILE\" in *.ts|*.tsx|*.js|*.jsx|*.json|*.css) npx prettier --write \"$FILE\" 2>/dev/null ;; *.py) \"$RUFF\" format \"$FILE\" 2>/dev/null ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
