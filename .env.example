# SQLite database file (created automatically)
SQLITE_PATH=storage/portfolio.db

# Service URLs (CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# External APIs
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Portfolio allocation targets (fraction of 1.0)
TARGET_FIXED_INCOME=0.35
TARGET_STOCKS=0.40
TARGET_CRYPTO=0.25

# Recommended cadence between contributions (informational only)
CONTRIBUTION_INTERVAL_DAYS=30

# Investment agent (autonomous Claude runs)
# Minimum holding period before an asset can be sold (B3/tax/strategy lock)
MIN_HOLDING_DAYS=30
AGENT_MODEL=opus
AGENT_EFFORT=max

# Telegram bot — get the token from @BotFather; chat_id is auto-filled by
# scripts/telegram_setup.py after you send /start to the bot. NEVER commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
