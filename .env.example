# SQLite database file (created automatically)
SQLITE_PATH=storage/portfolio.db

# Service URLs (CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# External APIs
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Portfolio allocation targets (fraction of 1.0)
TARGET_FIXED_INCOME=0.35
TARGET_STOCKS=0.40
TARGET_CRYPTO=0.25

# Investment agent (autonomous Claude runs)
# Minimum holding period before an asset can be sold (B3/tax/strategy lock)
MIN_HOLDING_DAYS=30
AGENT_MODEL=opus
AGENT_EFFORT=max

# Telegram bot — get the token from @BotFather; chat_id is auto-filled by
# scripts/telegram_setup.py after you send /start to the bot. NEVER commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Optional premium data MCPs for the autonomous analyst (ALL OPTIONAL).
# Leave blank to skip — each MCP server is only wired up when its key is set,
# and the agent always has the keyless servers (coingecko, yahoo-finance,
# defillama, exa). Fill any of these to auto-enable the matching desk:
#   GLASSNODE   on-chain metrics (MVRV/NUPL/SOPR/...)   https://studio.glassnode.com
#   COINGLASS   derivatives (funding/OI/liquidations)    https://www.coinglass.com/CryptoApi
#   MESSARI     crypto research/fundamentals             https://messari.io/api
#   FIRECRAWL   structured scraping (JS sites -> JSON)    https://www.firecrawl.dev
#   TAVILY      citation-grade web research               https://tavily.com
# NEVER commit real values.
GLASSNODE_API_KEY=
COINGLASS_API_KEY=
MESSARI_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
