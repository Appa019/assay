# SQLite database file (created automatically)
SQLITE_PATH=storage/portfolio.db

# Service URLs (CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# External APIs
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Portfolio allocation targets (fraction of 1.0)
TARGET_FIXED_INCOME=0.50
TARGET_STOCKS=0.35
TARGET_CRYPTO=0.15

# Investment agent (autonomous Claude runs)
# Sell lock per LOT and per CLASS. Stocks: compliance hold on securities.
# Crypto: no legal hold, shorter by design. CDB/fixed income never locks.
MIN_HOLDING_DAYS=30
MIN_HOLDING_DAYS_CRYPTO=7
# Meeting #1 prices only the delta when a weekly review is this fresh (days)
MACRO_DELTA_ENABLED=true
MACRO_DELTA_MAX_AGE_DAYS=7
AGENT_MODEL=opus
AGENT_EFFORT=max
# Per-step ceiling (seconds) for the headless Claude CLI subprocess
AGENT_STEP_TIMEOUT=2400
# Consecutive failed automatic runs before auto-resume gives up on an analysis
MAX_RUN_ATTEMPTS=5

# Telegram consultant chat (free-text conversation with the bot). Opus by
# default for advice quality; CHAT_MODEL=sonnet for snappier replies.
CHAT_MODEL=opus
CHAT_EFFORT=high
# Per-turn ceiling (seconds) for one chat answer
CHAT_TURN_TIMEOUT=900
# Rotate the chained chat session after this many turns (MEMORY.md carries context)
CHAT_MAX_TURNS=40

# CDB accrual assumption: % of CDI the paper pays (mandate: >= 100)
CDB_PCT_CDI=100.0

# TTL (seconds) of the cached market/macro context served by /api/macro
MARKET_CACHE_TTL=120

# Chat model routing. Two tiers, decided by rules (no triage model call):
# booking a spend runs on the fast tier, everything else on deep. Set to false
# to pin every turn to the deep tier.
CHAT_ROUTER_ENABLED=true
CHAT_FAST_MODEL=haiku
CHAT_FAST_EFFORT=low
# Middle tier: factual lookups (balance, price, pending orders)
CHAT_LOOKUP_MODEL=sonnet
CHAT_LOOKUP_EFFORT=low
CHAT_DEEP_MODEL=opus
CHAT_DEEP_EFFORT=high

# Telegram. The app (inbox + Web Push) is the notification channel; this is an
# opt-in MIRROR, off by default. The bot service is stopped on the Pi.
# Token from @BotFather; chat_id is auto-filled by scripts/telegram_setup.py
# after you send /start to the bot. NEVER commit real values.
TELEGRAM_MIRROR_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Optional premium data MCPs for the autonomous analyst (ALL OPTIONAL).
# Leave blank to skip — each MCP server is only wired up when its key is set,
# and the agent always has the keyless servers (coingecko, yahoo-finance,
# defillama, exa). Fill any of these to auto-enable the matching desk:
#   GLASSNODE   on-chain metrics (MVRV/NUPL/SOPR/...)   https://studio.glassnode.com
#   COINGLASS   derivatives (funding/OI/liquidations)    https://www.coinglass.com/CryptoApi
#   MESSARI     crypto research/fundamentals             https://messari.io/api
#   FIRECRAWL   structured scraping (JS sites -> JSON)    https://www.firecrawl.dev
#   TAVILY      citation-grade web research               https://tavily.com
# NEVER commit real values.
GLASSNODE_API_KEY=
COINGLASS_API_KEY=
MESSARI_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Long-lived CLI auth for HEADLESS machines only (the Pi). Generate with
# `claude setup-token` on a machine with a browser and paste here; every
# headless `claude` run then uses it instead of ~/.claude/.credentials.json,
# whose refresh token goes stale when two machines share it (A39).
# Leave blank on the desktop. NEVER commit the real value.
CLAUDE_CODE_OAUTH_TOKEN=
